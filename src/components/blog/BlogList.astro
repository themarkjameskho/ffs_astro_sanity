---
interface Props {
  posts: any[];
}

const { posts } = Astro.props;
---

<section class="w-full bg-white py-16">
  <div class="mx-auto w-full max-w-6xl px-4">
    {/* Header */}
    <div class="mb-8">
      <h1 class="mb-4 text-4xl font-bold text-slate-900">Blog</h1>
      <p class="text-lg text-slate-600">Discover pest control tips, industry insights, and expert advice</p>
    </div>

    {/* Horizontal Filters */}
    <div class="mb-8 rounded-lg border border-slate-200 bg-slate-50 p-6">
      <div class="grid gap-4 md:grid-cols-5">
        <div>
          <label class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider">Category</label>
          <select id="categoryFilter" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
            <option value="">All Categories</option>
          </select>
        </div>

        <div>
          <label class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider">Sort By</label>
          <select id="sortFilter" class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
            <option value="latest">Latest</option>
            <option value="oldest">Oldest</option>
            <option value="title-asc">Title (A-Z)</option>
            <option value="title-desc">Title (Z-A)</option>
          </select>
        </div>

        <div>
          <label class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider">From Date</label>
          <input
            type="date"
            id="dateFromFilter"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700"
          />
        </div>

        <div>
          <label class="mb-2 block text-xs font-semibold text-slate-900 uppercase tracking-wider">To Date</label>
          <input
            type="date"
            id="dateToFilter"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700"
          />
        </div>

        <div class="flex items-end">
          <button id="resetFilters" class="btn-primary">
            Reset
          </button>
        </div>
      </div>
    </div>

    {/* Posts Grid */}
    <div>
      <div id="postsContainer" class="grid gap-6 md:grid-cols-3 mb-12">
      </div>

      <div id="noResults" class="hidden rounded-xl border border-slate-200 bg-slate-50 p-8 text-center">
        <p class="text-slate-600">No posts found matching your filters.</p>
      </div>

      {/* Pagination */}
      <div class="mt-12 flex items-center justify-center gap-2">
        <button id="prevBtn" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">
          ← Previous
        </button>
        <div id="pageNumbers" class="flex gap-1"></div>
        <button id="nextBtn" class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">
          Next →
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ posts: JSON.stringify(posts) }}>
  const allPosts = JSON.parse(posts);
  const postsPerPage = 9;
  let currentPage = 1;
  let filteredPosts = [...allPosts];

  const categoryFilter = document.getElementById('categoryFilter');
  const sortFilter = document.getElementById('sortFilter');
  const dateFromFilter = document.getElementById('dateFromFilter');
  const dateToFilter = document.getElementById('dateToFilter');
  const resetFiltersBtn = document.getElementById('resetFilters');
  const postsContainer = document.getElementById('postsContainer');
  const noResults = document.getElementById('noResults');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');
  const pageNumbers = document.getElementById('pageNumbers');

  // Populate categories
  const categories = [
    ...new Set(
      allPosts.flatMap((p) => (Array.isArray(p.categories) ? p.categories.filter(Boolean) : []))
    )
  ];
  categories.forEach((cat) => {
    const option = document.createElement('option');
    option.value = cat;
    option.textContent = cat;
    categoryFilter.appendChild(option);
  });

  function renderPosts(posts) {
    postsContainer.innerHTML = '';

    if (posts.length === 0) {
      postsContainer.classList.add('hidden');
      noResults.classList.remove('hidden');
      updatePagination(0);
      return;
    }

    postsContainer.classList.remove('hidden');
    noResults.classList.add('hidden');

    const startIdx = (currentPage - 1) * postsPerPage;
    const endIdx = startIdx + postsPerPage;
    const paginatedPosts = posts.slice(startIdx, endIdx);

    paginatedPosts.forEach((post) => {
      const article = document.createElement('article');
      article.className = 'overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md';

      const imageHTML = post.featuredImage?.asset?.url
        ? `<div class="relative h-48 w-full overflow-hidden bg-slate-100">
             <img src="${post.featuredImage.asset.url}" alt="${post.featuredImage.alt || post.title}" class="h-full w-full object-cover" />
           </div>`
        : '';

      const categoryHTML =
        post.categories && post.categories.length > 0
          ? post.categories
              .map(
                (category) =>
                  `<span class="inline-block rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">${category}</span>`
              )
              .join('')
          : '';

      const dateHTML = post.publishedAt
        ? `<span class="text-xs text-slate-500">${new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>`
        : '';

      const tagsHTML = post.tags && post.tags.length > 0
        ? `<div class="mb-4 flex flex-wrap gap-2">
             ${post.tags.slice(0, 3).map((tag) => `<span class="text-xs text-slate-500">#${tag}</span>`).join('')}
           </div>`
        : '';

      article.innerHTML = `
        ${imageHTML}
        <div class="p-6">
          <div class="mb-2 flex items-center gap-2">
            ${categoryHTML}
            ${dateHTML}
          </div>
          <h3 class="mb-2 text-xl font-semibold text-slate-900 line-clamp-2">
            <a href="/blog/${post.slug.current}/" class="hover:text-blue-600">
              ${post.title}
            </a>
          </h3>
          <p class="mb-4 text-slate-600 line-clamp-2">${post.excerpt || 'Read more about this post...'}</p>
          ${tagsHTML}
          <a href="/blog/${post.slug.current}/" class="inline-block text-sm font-semibold text-blue-600 hover:text-blue-800">
            Read More →
          </a>
        </div>
      `;

      postsContainer.appendChild(article);
    });

    updatePagination(posts.length);
  }

  function updatePagination(totalPosts) {
    const totalPages = Math.ceil(totalPosts / postsPerPage);
    pageNumbers.innerHTML = '';

    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;

    for (let i = 1; i <= totalPages; i++) {
      const btn = document.createElement('button');
      btn.className = `px-3 py-1 rounded-lg text-sm font-medium ${
        i === currentPage
          ? 'bg-yellow-400 text-slate-900 font-semibold'
          : 'border border-slate-300 text-slate-700 hover:bg-slate-50'
      }`;
      btn.textContent = i;
      btn.disabled = i === currentPage;
      btn.addEventListener('click', () => {
        currentPage = i;
        filterAndSort();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      pageNumbers.appendChild(btn);
    }
  }

  function filterAndSort() {
    let filtered = [...allPosts];

    // Filter by category
    if (categoryFilter.value) {
      filtered = filtered.filter(
        (p) => Array.isArray(p.categories) && p.categories.includes(categoryFilter.value)
      );
    }

    // Filter by date range
    if (dateFromFilter.value) {
      const fromDate = new Date(dateFromFilter.value);
      filtered = filtered.filter((p) => new Date(p.publishedAt) >= fromDate);
    }

    if (dateToFilter.value) {
      const toDate = new Date(dateToFilter.value);
      toDate.setHours(23, 59, 59, 999);
      filtered = filtered.filter((p) => new Date(p.publishedAt) <= toDate);
    }

    // Sort
    const sortValue = sortFilter.value;
    if (sortValue === 'latest') {
      filtered.sort((a, b) => new Date(b.publishedAt) - new Date(a.publishedAt));
    } else if (sortValue === 'oldest') {
      filtered.sort((a, b) => new Date(a.publishedAt) - new Date(b.publishedAt));
    } else if (sortValue === 'title-asc') {
      filtered.sort((a, b) => a.title.localeCompare(b.title));
    } else if (sortValue === 'title-desc') {
      filtered.sort((a, b) => b.title.localeCompare(a.title));
    }

    filteredPosts = filtered;
    currentPage = 1;
    renderPosts(filtered);
  }

  // Event listeners
  categoryFilter.addEventListener('change', filterAndSort);
  sortFilter.addEventListener('change', filterAndSort);
  dateFromFilter.addEventListener('change', filterAndSort);
  dateToFilter.addEventListener('change', filterAndSort);

  resetFiltersBtn.addEventListener('click', () => {
    categoryFilter.value = '';
    sortFilter.value = 'latest';
    dateFromFilter.value = '';
    dateToFilter.value = '';
    currentPage = 1;
    filterAndSort();
  });

  prevBtn.addEventListener('click', () => {
    if (currentPage > 1) {
      currentPage--;
      renderPosts(filteredPosts);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  nextBtn.addEventListener('click', () => {
    const totalPages = Math.ceil(filteredPosts.length / postsPerPage);
    if (currentPage < totalPages) {
      currentPage++;
      renderPosts(filteredPosts);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Initial render (sorted latest to oldest by default)
  filterAndSort();
</script>
