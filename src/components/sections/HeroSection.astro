---
/**
 * HeroSection — v5-modern visual rebuild.
 *
 * Strategy: same Sanity content fields, completely rebuilt presentation.
 * Reference design: FFS v5-modern (styles-modern.css + components-1.jsx).
 *
 * Field mapping (Sanity → v5):
 *   subtitle           → .hero-meta chip (eyebrow)
 *   title + highlight  → <h1> with .leaf gradient on the highlighted word
 *   body               → .hero-byline (portable text, light theme)
 *   primaryCta*        → .btn-primary
 *   secondaryCta*      → .btn-ghost
 *   bullets            → .hero-trust strip
 *   sideImage          → .hero-side bento card (when present)
 *
 * Out of scope (intentionally not rendered in v5 hero — fields kept in Sanity
 * but ignored visually): coupon block, sideMapEmbed, layoutStyle/sideImageSize,
 * ctaSubtitle. They remain in the schema; we just don't render them here.
 */
import type { HeroSection } from "../../types/sections";
import { portableTextToHtml } from "../../lib/portableText";
import { splitHighlight } from "../../utils/highlightTitle";
import {
  buildSanityImageUrl,
  getHeroSideImageConfig,
  getHeroSideImageSrcSet,
  getHeroSideImageUrl,
} from "../../lib/imageOptimizer";
import { normalizeInternalHref } from "../../lib/links";

const props = Astro.props as HeroSection;
const primaryCtaHref = normalizeInternalHref(props.primaryCtaLink);
const secondaryCtaHref = normalizeInternalHref(props.secondaryCtaLink);
// Light theme — render body as ink, not inverted
const bodyHtml = props.body && props.body.length > 0
  ? portableTextToHtml(props.body, false)
  : "";
const titleSegments = props.title
  ? splitHighlight(props.title, props.highlightText)
  : [];
const hasBullets = Boolean(props.bullets?.length);

/**
 * Layout decision honors the Sanity `layoutStyle` radio (oneColumn vs
 * twoColumn) explicitly, so content authors get predictable behavior:
 *   - twoColumn + sideImage set     → bento card on the right (text left)
 *   - twoColumn + no sideImage      → single-column fallback (no empty bento)
 *   - oneColumn (or default)        → centered single column;
 *                                     sideImage (if uploaded) renders as
 *                                     the central image stage with badges
 *
 * This means: to have NO image at all, choose "One Column" AND clear the
 * image. To have a right-column image, choose "Two Column".
 */
const sideImageConfig = getHeroSideImageConfig(props.sideImageSize);
const sideImageSize = sideImageConfig.size;
const sideImageSizes = sideImageConfig.sizes;
const sideImageUrl = getHeroSideImageUrl(props.sideImage, props.sideImageSize);
const sideImageSrcSet = getHeroSideImageSrcSet(
  props.sideImage,
  props.sideImageSize,
);
const wantsTwoColumn = props.layoutStyle === 'twoColumn';
const hasSideImage = Boolean(props.sideImage?.url);
const hasSide = wantsTwoColumn && hasSideImage;

/**
 * Single-column hero image stage uses a 21:9 aspect ratio.
 * Build a Sanity URL at that exact aspect (with fit: 'crop') so
 * Sanity's crop + hotspot metadata is what drives the framing —
 * NOT a downstream CSS object-fit: cover center-crop.
 *
 * Square getHeroSideImageUrl() is fine for the bento side card,
 * but in the single-col stage it generates a square that CSS then
 * recrops to 21:9 ignoring hotspot.
 */
const heroStageWidths: Array<{ w: number; h: number }> = [
  { w: 480, h: 206 },     // 21:9 mobile
  { w: 768, h: 329 },
  { w: 1100, h: 471 },
  { w: 1600, h: 686 },
];
const heroStageImageUrl = hasSideImage && props.sideImage
  ? buildSanityImageUrl(props.sideImage, {
      width: 1100,
      height: 471,
      quality: 78,
      format: 'webp',
      fit: 'crop',
    })
  : '';
const heroStageSrcSet = hasSideImage && props.sideImage
  ? heroStageWidths
      .map(({ w, h }) => {
        const url = buildSanityImageUrl(props.sideImage, {
          width: w,
          height: h,
          quality: w <= 768 ? 70 : 78,
          format: 'webp',
          fit: 'crop',
        });
        return `${url} ${w}w`;
      })
      .join(', ')
  : '';

// Sanity-driven frame choice for the right column. Defaults to 'bordered'
// — clean image with a thin red brand border, no labels, no inner padding.
const sideFrame = ((props as any).sideImageFrame as 'card' | 'bordered' | 'plain' | undefined) ?? 'bordered';
---

<section class="hero-v5">
  <div class="hero-v5-wrap">
    <div class={`hero-v5-grid ${hasSide ? "with-side" : "no-side"}`}>
      <div class="hero-v5-content">
        {props.subtitle && (
          <div class="hero-v5-meta">
            <span class="hero-v5-meta-dot" aria-hidden="true"></span>
            <span class="hero-v5-meta-text">{props.subtitle}</span>
          </div>
        )}

        {titleSegments.length > 0 && (
          <h1 class="hero-v5-h1">
            {titleSegments.map((segment) =>
              segment.highlight ? (
                <span class="leaf">{segment.text}</span>
              ) : (
                <span>{segment.text}</span>
              ),
            )}
          </h1>
        )}

        {bodyHtml && (
          <div class="hero-v5-byline" set:html={bodyHtml} />
        )}

        {/* Single-column hero with image stage — renders only when both
            conditions are true:
              1. layoutStyle is oneColumn (no right-side bento)
              2. Sanity sideImage is uploaded
            Otherwise (e.g., blog index, terms pages, any heading-only
            hero) the image stage and the floating overlay badges are
            skipped entirely so the hero shows just heading + body + CTAs. */}
        {!hasSide && hasSideImage && (
          <figure class="hero-v5-image-stage has-image">
            <img
              src={heroStageImageUrl}
              srcset={heroStageSrcSet}
              sizes="(min-width: 1100px) 1100px, 100vw"
              alt={props.sideImage?.alt ?? ''}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width={1100}
              height={471}
            />

            {/* Top-right overlay: Google review rating */}
            <div class="hero-v5-badge hero-v5-badge-tr" role="img" aria-label="4.8 stars on Google">
              <span class="hero-v5-google-glyph" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                </svg>
              </span>
              <div class="hero-v5-badge-text">
                <span class="hero-v5-badge-rating">
                  <strong>4.8</strong>
                  <span class="hero-v5-badge-stars" aria-hidden="true">★★★★★</span>
                </span>
                <span class="hero-v5-badge-sub">Google reviews</span>
              </div>
            </div>

            {/* Bottom-left overlay: Locally Owned & Operated */}
            <div class="hero-v5-badge hero-v5-badge-bl" role="img" aria-label="Locally owned and operated">
              <span class="hero-v5-badge-pin" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                  <polyline points="9 22 9 12 15 12 15 22" />
                </svg>
              </span>
              <div class="hero-v5-badge-text">
                <strong class="hero-v5-badge-title">Locally Owned</strong>
                <span class="hero-v5-badge-sub">&amp; Operated</span>
              </div>
            </div>
          </figure>
        )}

        {(props.primaryCtaLabel || props.secondaryCtaLabel) && (
          <div class="hero-v5-ctas">
            {props.primaryCtaLabel && primaryCtaHref && (
              <a href={primaryCtaHref} class="btn-primary">
                {props.primaryCtaLabel}
                <svg viewBox="0 0 24 24" class="hero-v5-cta-arrow" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
            )}
            {props.secondaryCtaLabel && secondaryCtaHref && (
              <a href={secondaryCtaHref} class="btn-ghost">
                {props.secondaryCtaLabel}
              </a>
            )}
          </div>
        )}

        {hasBullets && (
          <div class="hero-v5-trust-wrap">
            {(props as any).bulletsTitle && (
              <p class="hero-v5-trust-title">{(props as any).bulletsTitle}</p>
            )}
            <ul class="hero-v5-trust">
              {props.bullets!.map((item) => (
                <li>
                  <span class="hero-v5-trust-mark" aria-hidden="true">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {hasSide && (
        <aside class={`hero-v5-side hero-v5-side--${sideFrame}`} aria-label="Hero feature">
          {sideFrame === 'card' && (
            <div class="hero-v5-side-head">
              <span>What we do</span>
              <span class="hero-v5-side-tag">Live in the metro</span>
            </div>
          )}
          <div class="hero-v5-side-image">
            <img
              src={sideImageUrl}
              srcset={sideImageSrcSet}
              sizes={sideImageSizes}
              alt={props.sideImage?.alt ?? ""}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width={sideImageSize}
              height={sideImageSize}
            />
          </div>
        </aside>
      )}
    </div>
  </div>
</section>

<style>
  /* === v5-modern Hero ==============================================
   * Padding tightened so the hero fits the viewport on initial load
   * without forcing a scroll on common 720–900px laptop screens.
   */
  .hero-v5 {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: 36px 0 64px;
    background: var(--warm-white);
    color: var(--ink-soft);
  }

  /* Soft radial flourishes — green at top-right, warm orange at bottom-left */
  .hero-v5::before {
    content: "";
    position: absolute;
    top: -180px;
    right: -160px;
    width: 720px;
    height: 720px;
    background: radial-gradient(
      circle at 30% 30%,
      var(--green-bio) 0%,
      var(--green-primary) 40%,
      transparent 70%
    );
    opacity: 0.18;
    filter: blur(40px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .hero-v5::after {
    content: "";
    position: absolute;
    bottom: -200px;
    left: -180px;
    width: 560px;
    height: 560px;
    background: radial-gradient(circle, var(--heat-orange) 0%, transparent 60%);
    opacity: 0.08;
    filter: blur(40px);
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
  }

  .hero-v5-wrap {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero-v5-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .hero-v5-grid.with-side {
    grid-template-columns: 1fr;
  }

  @media (min-width: 980px) {
    .hero-v5-grid.with-side {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  /* On mobile, the 2-column hero stacks (image below content). Center
     everything in the content column so it reads as a unified, balanced
     hero — same pattern as the 1-column variant. Desktop ≥980px keeps
     the side-by-side left-aligned layout. */
  @media (max-width: 979px) {
    .hero-v5-grid.with-side .hero-v5-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      width: 100%;
    }
    .hero-v5-grid.with-side .hero-v5-meta {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-v5-grid.with-side .hero-v5-byline {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-v5-grid.with-side .hero-v5-ctas {
      justify-content: center;
      width: 100%;
    }
  }

  /* === Single-column hero: center all content =====================
   * The home page renders this branch (no Sanity sideImage). Every
   * element is centered, text content is constrained to a readable
   * column, the image stage fills the wrap for visual punch.
   */
  .hero-v5-grid.no-side .hero-v5-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }

  .hero-v5-grid.no-side .hero-v5-meta {
    margin-left: auto;
    margin-right: auto;
  }

  .hero-v5-grid.no-side .hero-v5-h1 {
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-v5-grid.no-side .hero-v5-byline {
    /* Single-column body matches the H1's max-width (880px) so the
       paragraph lines up with the title and breathes across ~3 lines
       instead of getting squeezed to 4 narrow lines. */
    max-width: 880px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-v5-grid.no-side .hero-v5-image-stage {
    width: 100%;
    max-width: 1080px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-v5-grid.no-side .hero-v5-ctas {
    justify-content: center;
    width: 100%;
  }

  .hero-v5-grid.no-side .hero-v5-trust {
    justify-content: center;
    width: 100%;
  }

  /* === Meta chip ==================================================== */
  .hero-v5-meta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 13px;
    color: var(--green-deep);
    background: var(--warm-white);
    padding: 8px 16px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(29, 29, 29, 0.05);
    border: 1px solid rgba(29, 29, 29, 0.06);
    margin-bottom: 32px;
  }

  /* Red accent dot — pulsing live-dispatch indicator (decorative). */
  .hero-v5-meta-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--emergency);
    box-shadow: 0 0 0 0 rgba(202, 30, 53, 0.7);
    animation: hero-v5-pulse 2.4s ease-out infinite;
  }

  @keyframes hero-v5-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(202, 30, 53, 0.7); }
    50%      { box-shadow: 0 0 0 6px rgba(202, 30, 53, 0); }
  }

  /* === H1 ============================================================
   * Sized down a touch more so the hero fits within a typical laptop
   * viewport without scrolling. Still distinctly larger than the
   * section H2 scale (clamp(32, 4.5vw, 52)) for visual hierarchy.
   */
  .hero-v5-h1 {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(32px, 4.6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink-black);
    margin-bottom: 22px;
    text-wrap: balance;
  }

  /* Highlighted word: solid brand red, italic. 5.4:1 vs warm-white = AA.
     Replaces the older green leaf-gradient per brand direction. */
  .hero-v5-h1 .leaf {
    display: inline-block;
    color: var(--emergency);
    font-style: italic;
    padding-right: 0.05em;
  }

  /* === Byline =======================================================
   * Uniform body scale across the whole site: 17px / 1.65 line-height,
   * ink-soft color. Default max-width is wider so the body can spread
   * to ~3 lines instead of feeling cramped under the title.
   */
  .hero-v5-byline {
    font-family: var(--font-body);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 820px;
    margin-bottom: 28px;
  }

  .hero-v5-byline :global(p) {
    margin: 0 0 0.75em;
  }

  .hero-v5-byline :global(p:last-child) {
    margin-bottom: 0;
  }

  .hero-v5-byline :global(strong),
  .hero-v5-byline :global(b) {
    color: var(--ink-black);
    font-weight: 600;
  }

  /* === Single-column hero image stage ==============================
   * Aspect ratio reduced to 21/9 so the image keeps presence but
   * doesn't push CTAs below the fold on common laptop sizes.
   */
  .hero-v5-image-stage {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    aspect-ratio: 21 / 9;
    margin: 8px 0 28px;
    background: linear-gradient(135deg, var(--sand-pale) 0%, var(--warm-white) 60%);
    box-shadow:
      0 1px 0 rgba(29, 29, 29, 0.04),
      0 24px 48px -24px rgba(29, 29, 29, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-v5-image-stage::before {
    content: "";
    position: absolute;
    top: -60px;
    right: -60px;
    width: 240px;
    height: 240px;
    background: radial-gradient(circle, var(--green-bio) 0%, transparent 70%);
    opacity: 0.18;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-v5-image-stage.has-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: relative;
    z-index: 1;
  }

  .hero-v5-image-stage.is-placeholder {
    border: 1px dashed rgba(94, 127, 58, 0.22);
  }

  .hero-v5-image-glyph {
    position: relative;
    z-index: 1;
    width: 64px;
    height: 64px;
    color: var(--green-deep);
    opacity: 0.42;
  }

  .hero-v5-image-glyph svg {
    width: 100%;
    height: 100%;
  }

  /* === Floating overlay badges ===================================== */
  .hero-v5-badge {
    position: absolute;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px;
    background: var(--warm-white);
    border-radius: 999px;
    border: 1px solid rgba(29, 29, 29, 0.06);
    box-shadow:
      0 1px 0 rgba(29, 29, 29, 0.04),
      0 18px 36px -16px rgba(29, 29, 29, 0.32);
  }

  .hero-v5-badge-tr {
    top: 20px;
    right: 20px;
  }

  .hero-v5-badge-bl {
    left: 20px;
    bottom: 20px;
  }

  .hero-v5-badge-text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .hero-v5-google-glyph {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  .hero-v5-google-glyph svg {
    width: 100%;
    height: 100%;
  }

  .hero-v5-badge-rating {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    color: var(--ink-black);
  }

  .hero-v5-badge-rating strong {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .hero-v5-badge-stars {
    color: var(--heat-orange);
    font-size: 12px;
    letter-spacing: 1px;
  }

  .hero-v5-badge-sub {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 2px;
    letter-spacing: 0.02em;
  }

  .hero-v5-badge-pin {
    width: 22px;
    height: 22px;
    color: var(--green-deep);
    flex-shrink: 0;
  }

  .hero-v5-badge-pin svg {
    width: 100%;
    height: 100%;
  }

  .hero-v5-badge-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 14px;
    color: var(--ink-black);
    letter-spacing: -0.01em;
  }

  /* Mobile: shrink badges and pull them tight against image edges.
     Image stage flips to 4/3 portrait-ish for phones so the photo
     stays prominent without taking the entire viewport. */
  @media (max-width: 720px) {
    .hero-v5-image-stage {
      aspect-ratio: 4 / 3;
      border-radius: 18px;
      margin: 6px 0 22px;
    }

    .hero-v5-badge {
      padding: 9px 14px;
      gap: 9px;
    }

    .hero-v5-badge-tr {
      top: 12px;
      right: 12px;
    }

    .hero-v5-badge-bl {
      left: 12px;
      bottom: 12px;
    }

    .hero-v5-google-glyph {
      width: 22px;
      height: 22px;
    }

    .hero-v5-badge-rating strong {
      font-size: 14px;
    }

    .hero-v5-badge-sub {
      font-size: 10px;
    }

    .hero-v5-badge-title {
      font-size: 12px;
    }

    .hero-v5-badge-pin {
      width: 18px;
      height: 18px;
    }
  }

  /* === CTAs ========================================================= */
  .hero-v5-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-v5-cta-arrow {
    width: 16px;
    height: 16px;
    display: inline-block;
    transition: transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .btn-primary:hover .hero-v5-cta-arrow,
  .btn-primary:focus-visible .hero-v5-cta-arrow {
    transform: translateX(3px);
  }

  /* === Trust strip from bullets ===================================== */
  .hero-v5-trust-wrap {
    margin-top: 32px;
    width: 100%;
  }

  .hero-v5-trust-title {
    margin: 0 0 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(15px, 1.2vw, 17px);
    color: var(--ink-black);
    letter-spacing: -0.01em;
  }

  .hero-v5-trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
  }

  .hero-v5-trust li {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(15px, 1.1vw, 16px);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .hero-v5-trust-mark {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(94, 127, 58, 0.12);
    color: var(--green-deep);
    border-radius: 50%;
    font-size: 12px;
    font-weight: 700;
    margin-top: 1px;
  }

