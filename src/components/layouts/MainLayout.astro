// homepage-specific (BreadcrumbList has only "Home", WebPage @id is
// the root URL, etc.), so it must only render on `/`. On every other
// page we emit a slimmer Organization-only schema instead.
const pathname = Astro.url?.pathname ?? "/";
const isHomePage = pathname === "/" || pathname === "";

