          }
        },
        {
          "@type": "Question",
          name: "Will I need to throw away my furniture after a bed bug infestation?",
          acceptedAnswer: {
            "@type": "Answer",
            text: `No. ${brandName} treatments, especially heat treatment, are designed to penetrate furniture and household items to kill bed bugs without damaging belongings, helping customers avoid unnecessary replacement costs.`
          }
        },
        {
          "@type": "Question",
          name: "Can you guarantee privacy during the bed bug extermination process?",
          acceptedAnswer: {
            "@type": "Answer",
            text: `Yes. ${brandName} emphasizes discretion and privacy, including unmarked service trucks and technicians trained to perform treatments with confidentiality and respect for the property.`
          }
        },
        {
          "@type": "Question",
          name: "Do I need to prepare anything before treatment?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Minimal preparation is needed before treatment. The team guides customers step by step, which may include clearing the area around the infestation and following treatment-specific instructions."
          }
        }
      ],
      inLanguage: "en-US"
    }
  ]
};

// Inner-page schema: a slim Organization stub so /service-area/*, /blog/*,
// /bed-bug-treatment/* etc. all still announce the brand to Google
// without polluting them with homepage-only graph nodes.
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HomeAndConstructionBusiness", "PestControl"],
  "@id": `${siteUrl}/#localbusiness`,
  name: brandName,
  url: `${siteUrl}/`,
  image: absoluteLogoUrl,
  logo: absoluteLogoUrl,
  telephone: siteProfile.primaryPhoneDashed,
  priceRange: "Varies",
  areaServed: [
    { "@type": "City", name: "Chicago" },
    { "@type": "City", name: "Milwaukee" },
  ],
  contactPoint: [
    {
      "@type": "ContactPoint",
      telephone: siteProfile.primaryPhoneDashed,
      contactType: "Illinois service line",
      areaServed: "US",
      availableLanguage: "en",
    },
    {
      "@type": "ContactPoint",
      telephone: siteProfile.secondaryPhoneDashed,
      contactType: "Wisconsin service line",
      areaServed: "US",
      availableLanguage: "en",
    },
  ],
  sameAs: [],
};
---

<!doctype html>
<html lang="en" class="bg-surface text-[--color-text]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    {gaScript && <script is:inline set:html={gaScript}></script>}

    {/*
      CallRail dynamic-number swap snippet is NOT placed here.

      Per CallRail's account-side guidance to Cory (May 2026): the swap.js
      tag must live between the <body>...</body> tags, not in <head>.
      Moving it out lets CallRail's verifier detect it correctly — when
      it lived here in <head>, the tester reported "never returns a
      result" even though the script was loading.

      The actual <script> placement is just before </body> at the end of
      this file. Preconnect hints to cdn.callreports.com remain in <head>
      so the TCP/TLS handshake still warms up early.
    */}

    <!-- Preconnect to critical domains for faster connection establishment -->
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="preconnect" href="https://cdn.callreports.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.sanity.io" />
    <link rel="dns-prefetch" href="https://cdn.callreports.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />
    <link rel="dns-prefetch" href="https://www.gstatic.com" />

    <!-- Preload critical fonts with high priority -->
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-sans-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/open-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      heroPreloadUrlMobile && (
        <link
          rel="preload"
          as="image"
          href={heroPreloadUrlMobile}
          imagesrcset={heroPreloadSrcSetMobile || undefined}
          imagesizes={heroPreloadSizesMobile || undefined}
          fetchpriority="high"
          media="(max-width: 767px)"
        />
      )
    }

    {
      heroPreloadUrl && (
        <link
          rel="preload"
          as="image"
          href={heroPreloadUrl}
          imagesrcset={heroPreloadSrcSet || undefined}
          imagesizes="(max-width: 1024px) 100vw, 900px"
          fetchpriority="high"
          media="(min-width: 768px)"
        />
      )
    }

    <!-- Favicon. Bump the version number any time the favicon artwork changes. -->
    <link rel="icon" type="image/png" sizes="any" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/favicon.png?v=3" />

    <!-- iOS Safari / Chrome Android tint the status bar with this color.
         Matched to --emergency (brand red) so the area above the page
         flows into the red "Live dispatch" mast-bar below it. -->
    <meta name="theme-color" content="#C84545" />
    <meta name="version" content="1.0.5" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={absoluteLogoUrl}
    />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalHref} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content={absoluteLogoUrl}
    />

    {/*
      Structured-data block.

      Homepage (`/`) gets the full @graph that mirrors the legacy WP site
      (LocalBusiness + Services + OfferCatalog + WebSite + WebPage +
      BreadcrumbList + FAQPage). Every other route gets a slimmer
      Organization-only schema — emitting the homepage graph everywhere
      would tell Google every page IS the homepage (wrong WebPage @id,
      wrong breadcrumb, etc.).
    */}
    {isHomePage ? (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(homepageSchema)}
      />
    ) : (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(organizationSchema)}
      />
    )}

    <link rel="canonical" href={canonicalHref} />

    <title>{pageTitle}</title>

    <!-- CRITICAL CSS - Inlined to prevent render-blocking -->
    <style is:inline set:html={criticalCss}></style>
  </head>
  <body>
    <div
      id="nav-sticky-sentinel"
      aria-hidden="true"
      class="pointer-events-none absolute left-0 top-0 h-[60px] w-px"
    >
    </div>






    

    <!-- ============================================================
         Top mast-bar: red status strip with live-dispatch indicator.
         Phones moved to the main header row as filled CTA buttons.
         ============================================================ -->
    <div class="bbg-mast-bar" role="region" aria-label="Service status">
      <div class="bbg-mast-bar-inner">
        <div class="bbg-mast-bar-left">
          <span class="bbg-mast-live">
            <span class="bbg-mast-live-dot" aria-hidden="true"></span>
            Live dispatch · IL &amp; WI metros
          </span>
          <span class="bbg-mast-tag">1-day heat treatment · 30-day re-treat guarantee</span>
        </div>
        <div class="bbg-mast-bar-right">
          <span class="bbg-mast-tag">Get your sleep back tonight</span>
        </div>
      </div>
    </div>

    <header id="site-nav" class="bbg-mast">
      <div class="bbg-mast-row">
        <a href="/" class="bbg-mast-brand" aria-label={`${brandName} home`}>
          <img
            src={logoSrc}
            alt={`${brandName} logo`}
            class="bbg-mast-brand-img"
            loading="eager"
            width={220}
            height={80}
            fetchpriority="high"
            decoding="async"
          />
        </a>

        <nav class="bbg-mast-nav" aria-label="Primary">
          <a
            href="/"
            class={`bbg-mast-nav-item ${isActiveHref("/") ? "is-active" : ""}`}
          >
            Home
          </a>

          {desktopNavItems.map((item) => {
            const hasChildren = Boolean(item.children?.length);
            const isActive = isActiveHref(item.href);

            if (hasChildren) {
              return (
                <div class="bbg-mast-nav-group">
                  <a
                    href={item.href}
                    class={`bbg-mast-nav-item bbg-mast-nav-trigger ${isActive ? "is-active" : ""}`}
                  >
                    {item.label}
                    <svg viewBox="0 0 24 24" class="bbg-mast-nav-chev" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                  </a>

                  <div class="bbg-mast-nav-pop">
                    <div class="bbg-mast-nav-pop-inner">
                      {item.children?.map((child) => (
                        <a href={child.href} class="bbg-mast-nav-pop-link">
                          {child.label}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              );
            }

            return (
              <a
                href={item.href}
                class={`bbg-mast-nav-item ${isActive ? "is-active" : ""}`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <div class="bbg-mast-end">
          {/* Two stacked phone CTAs — equal weight, no outline, white text. */}
          <div class="bbg-mast-phones">
            <a href={primaryPhoneHref} class="btn-primary bbg-mast-phone-btn">
              Illinois {primaryPhoneLabel}
            </a>
            <a href={secondaryPhoneHref} class="btn-secondary bbg-mast-phone-btn">
              Wisconsin {secondaryPhoneLabel}
            </a>
          </div>

          <button
            class="bbg-mast-menu-btn"
            aria-label="Open navigation"
            data-mobile-menu-trigger
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <path d="M5 6h14M5 12h14M5 18h14"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <style>
      /* === Masthead =================================================== */
      /* Top mast-bar: red status strip per brand direction. */
      .bbg-mast-bar {
        background: var(--emergency);
        color: #ffffff;
        font-family: var(--font-body);
        font-size: 13px;
      }

      .bbg-mast-bar-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 10px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
      }

      .bbg-mast-bar-left {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
        align-items: center;
        color: #ffffff;
      }

      .bbg-mast-live {
        display: inline-flex;
        align-items: center;
        font-weight: 600;
      }

      /* On the red mast-bar, the live dot uses warm-white so it's visible
         against the red surface (red-on-red would disappear). */
      .bbg-mast-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #ffffff;
        margin-right: 8px;
        box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
        animation: bbg-mast-pulse 2.4s ease-out infinite;
      }

      @keyframes bbg-mast-pulse {
        0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7); }
        50%      { box-shadow: 0 0 0 6px rgba(255, 255, 255, 0); }
      }

      .bbg-mast-tag {
        /* No opacity here — the previous 0.92 dropped the effective
           text/red-bg contrast just below WCAG AA's 4.5:1 threshold.
           Pure white on #C84545 sits at ~4.75:1, which passes. */
        color: #ffffff;
        font-weight: 600;
      }

      .bbg-mast-bar-right {
        display: flex;
        gap: 16px;
        align-items: center;
        font-weight: 600;
        color: #ffffff;
      }

      @media (max-width: 880px) {
        .bbg-mast-bar-left .bbg-mast-tag { display: none; }
        .bbg-mast-bar-inner { padding: 8px 16px; gap: 12px; flex-wrap: wrap; }
        .bbg-mast-bar-right { gap: 10px; }
      }

      @media (max-width: 720px) {
        .bbg-mast-bar-right { display: none; }
      }

      /* === Sticky main nav row ======================================= */
      .bbg-mast {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(247, 245, 241, 0.85);
        backdrop-filter: saturate(140%) blur(14px);
        -webkit-backdrop-filter: saturate(140%) blur(14px);
        transition: background 200ms ease, box-shadow 200ms ease, padding 200ms ease;
      }

      .bbg-mast[data-stuck="true"] {
        background: rgba(247, 245, 241, 0.96);
        box-shadow:
          0 1px 0 rgba(29, 29, 29, 0.06),
          0 8px 24px rgba(29, 29, 29, 0.05);
      }

      .bbg-mast-row {
        max-width: 1280px;
        margin: 0 auto;
        padding: 16px 24px;
        /* 3-column grid: brand left, nav centered (auto col, justify-self
           center), end right. This perfectly centers the nav between the
           brand and the right-side CTAs regardless of their widths. */
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 24px;
      }

      .bbg-mast-row > .bbg-mast-brand { justify-self: start; }
      .bbg-mast-row > .bbg-mast-nav   { justify-self: center; margin: 0; }
      .bbg-mast-row > .bbg-mast-end   { justify-self: end; margin: 0; }

      .bbg-mast[data-stuck="true"] .bbg-mast-row {
        padding-top: 12px;
        padding-bottom: 12px;
      }

      .bbg-mast-brand {
        display: flex;
        align-items: center;
        flex-shrink: 0;
      }

      .bbg-mast-brand-img {
        height: 80px;
        width: auto;
        object-fit: contain;
        transition: height 200ms ease;
      }

      .bbg-mast[data-stuck="true"] .bbg-mast-brand-img {
        height: 64px;
      }

      /* Pill navigation */
      .bbg-mast-nav {
        display: flex;
        gap: 4px;
        margin-left: auto;
        background: var(--warm-white);
        padding: 6px;
        border-radius: 999px;
        box-shadow: 0 4px 14px rgba(29, 29, 29, 0.05);
        border: 1px solid rgba(29, 29, 29, 0.06);
      }

      .bbg-mast-nav-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--font-heading);
        font-weight: 500;
        font-size: 14px;
        color: var(--ink-soft);
        padding: 9px 16px;
        border-radius: 999px;
        transition: background 180ms ease, color 180ms ease;
        white-space: nowrap;
      }

      /* Nav hover: soft sage tint with brand-green text */
      .bbg-mast-nav-item:hover,
      .bbg-mast-nav-item:focus-visible {
        background: var(--surface-sage);
        color: var(--green-primary);
      }

      /* Active page: filled brand-green pill with white text */
      .bbg-mast-nav-item.is-active {
        background: var(--green-primary);
        color: #ffffff;
      }

      .bbg-mast-nav-item.is-active:hover,
      .bbg-mast-nav-item.is-active:focus-visible {
        background: var(--green-deep);
        color: #ffffff;
      }

      .bbg-mast-nav-chev {
        width: 12px;
        height: 12px;
        transition: transform 180ms ease;
      }

      .bbg-mast-nav-group {
        position: relative;
      }

      .bbg-mast-nav-group:hover .bbg-mast-nav-chev,
      .bbg-mast-nav-group:focus-within .bbg-mast-nav-chev {
        transform: rotate(180deg);
      }

      .bbg-mast-nav-pop {
        position: absolute;
        left: 50%;
        top: 100%;
        transform: translate(-50%, 8px);
        min-width: 280px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 180ms ease, transform 180ms ease;
        padding-top: 12px;
      }

      .bbg-mast-nav-group:hover .bbg-mast-nav-pop,
      .bbg-mast-nav-group:focus-within .bbg-mast-nav-pop {
        opacity: 1;
        pointer-events: auto;
        transform: translate(-50%, 0);
      }

      .bbg-mast-nav-pop-inner {
        background: var(--warm-white);
        border-radius: 18px;
        padding: 8px;
        box-shadow:
          0 1px 0 rgba(29, 29, 29, 0.04),
          0 24px 48px -16px rgba(29, 29, 29, 0.18);
        border: 1px solid rgba(29, 29, 29, 0.06);
      }

      .bbg-mast-nav-pop-link {
        display: block;
        font-family: var(--font-heading);
        font-weight: 500;
        font-size: 14px;
        color: var(--ink-soft);
        padding: 10px 14px;
        border-radius: 12px;
        transition: background 160ms ease, color 160ms ease;
      }

      .bbg-mast-nav-pop-link:hover,
      .bbg-mast-nav-pop-link:focus-visible {
        background: var(--sand-pale);
        color: var(--green-deep);
      }

      /* Right side: CTA + mobile button */
      .bbg-mast-end {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-left: auto;
      }

      .bbg-mast-nav + .bbg-mast-end {
        margin-left: 0;
      }

      /* Two-phone stack — equal weight, no outline, white text. */
      .bbg-mast-phones {
        display: flex;
        flex-direction: column;
        gap: 6px;
        align-items: stretch;
      }

      .bbg-mast-phone-btn {
        min-width: 220px;
        min-height: 40px;
        padding: 9px 16px;
        font-size: 13px;
        white-space: nowrap;
        justify-content: center;
        /* Hover: shine sweep + lift + glow. The shine is a diagonal white
           gradient that travels left→right across the button on hover. */
        position: relative;
        overflow: hidden;
        isolation: isolate;
        transition:
          transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
          box-shadow 240ms ease;
      }

      .bbg-mast-phone-btn::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          120deg,
          transparent 0%,
          transparent 38%,
          rgba(255, 255, 255, 0.35) 50%,
          transparent 62%,
          transparent 100%
        );
        transform: translateX(-120%);
        transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
        pointer-events: none;
        z-index: 0;
      }

      .bbg-mast-phone-btn:hover,
      .bbg-mast-phone-btn:focus-visible {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px -10px rgba(31, 77, 60, 0.45);
      }

      .bbg-mast-phone-btn:hover::before,
      .bbg-mast-phone-btn:focus-visible::before {
        transform: translateX(120%);
      }

      .bbg-mast-phone-btn > * {
        position: relative;
        z-index: 1;
      }

      .bbg-mast-menu-btn {
        display: none;
        width: 44px;
        height: 44px;
        background: var(--warm-white);
        border: 1px solid rgba(29, 29, 29, 0.1);
        border-radius: 999px;
        align-items: center;
        justify-content: center;
        color: var(--ink-black);
        box-shadow: 0 4px 12px rgba(29, 29, 29, 0.06);
        transition: background 180ms ease;
      }

      .bbg-mast-menu-btn:hover {
        background: var(--sand-pale);
      }

      .bbg-mast-menu-btn svg {
        width: 22px;
        height: 22px;
      }

      @media (max-width: 1080px) {
        .bbg-mast-nav {
          display: none;
        }

        .bbg-mast-phones {
          display: none;
        }

        .bbg-mast-menu-btn {
          display: inline-flex;
        }

        /* Switch back to flex on mobile (desktop grid layout doesn't make
           sense when nav and phones are hidden). Logo left, hamburger
           pulled inboard from the right edge so the composition feels
           balanced rather than corner-stuck. */
        .bbg-mast-row {
          display: flex;
          justify-content: space-between;
          padding-right: 32px;
        }
        .bbg-mast-row > .bbg-mast-end {
          justify-self: auto;
          margin-left: auto;
        }

        /* On mobile, let the regular header scroll away with the page.
           The floating sticky pill takes over at the top after scroll
           (handled by IntersectionObserver on #nav-sticky-sentinel).
           Opaque bg + hairline divider so it reads against the body. */
        .bbg-mast {
          position: static;
          background: var(--surface-white);
          border-bottom: 1px solid rgba(29, 29, 29, 0.08);
          backdrop-filter: none;
          -webkit-backdrop-filter: none;
        }

        .bbg-mast-row {
          padding-top: 14px;
          padding-bottom: 14px;
          min-height: 64px;
          align-items: center;
        }

        /* Sage tint makes the hamburger a clear tap target. */
        .bbg-mast-menu-btn {
          background: var(--surface-sage);
        }
      }

      @media (max-width: 560px) {
        .bbg-mast-row {
          padding: 12px 16px;
          gap: 12px;
        }

        .bbg-mast-brand-img {
          height: 60px;
        }
      }
    </style>









<div
      id="mobile-sticky-controls"
      class="bbg-sticky-pill opacity-0 scale-90 pointer-events-none"
    >
      <a
        href="/"
        aria-label={`${brandName} home`}
        class="bbg-sticky-pill-brand"
      >
        <img
          src={logoSrc}
          alt={`${brandName} logo`}
          class="bbg-sticky-pill-brand-img"
          width={72}
          height={72}
          loading="lazy"
          decoding="async"
        />
      </a>
      <button
        class="bbg-sticky-pill-menu"
        aria-label="Open navigation"
        data-mobile-menu-trigger
      >
        <span class="sr-only">Open menu</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <path d="M5 6h14M5 12h14M5 18h14"></path>
        </svg>
      </button>
    </div>

    <div
      id="mobile-menu"
      class="mobile-menu-overlay bbg-drawer-overlay hidden"
      aria-hidden="true"
      inert
    >
      <div
        class="mobile-menu-panel bbg-drawer-panel"
        data-mobile-menu-panel
      >
        <div class="bbg-drawer-head">
          <a href="/" class="bbg-drawer-brand" aria-label={`${brandName} home`}>
            <img
              src={logoSrc}
              alt={`${brandName} logo`}
              class="bbg-drawer-brand-img"
              width={110}
              height={42}
              loading="lazy"
              decoding="async"
            />
          </a>
          <button
            id="mobile-menu-close"
            class="bbg-drawer-close"
            aria-label="Close menu"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M6 18L18 6" />
            </svg>
          </button>
        </div>

        <p class="bbg-drawer-tagline">Get your sleep back · IL &amp; WI</p>

        <nav class="bbg-drawer-nav" aria-label="Mobile primary">
          {MOBILE_NAV.map((item, index) => {
            const hasChildren = !!item.children?.length;
            const submenuId = `mobile-menu-sub-${index}`;
            return (
              <div class="bbg-drawer-row">
                {hasChildren ? (
                  <>
                    <button
                      class="bbg-drawer-toggle"
                      data-mobile-menu-toggle={submenuId}
                      aria-expanded="false"
                    >
                      <span>{item.label}</span>
                      <svg viewBox="0 0 24 24" class="bbg-drawer-chev" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" />
                      </svg>
                    </button>
                    <div
                      id={submenuId}
                      class="bbg-drawer-sub hidden"
                      data-mobile-menu-submenu
                    >
