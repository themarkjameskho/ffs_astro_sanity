        font-size: 16px;
        color: var(--warm-white);
        transition: color 180ms ease;
      }

      .bbg-foot-nap-phones a:hover {
        color: var(--sand-pale);
      }

      .bbg-foot-nap-state {
        font-weight: 400;
        font-size: 14px;
        color: rgba(247, 245, 241, 0.78);
      }

      .bbg-foot-eyebrow {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 11px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        /* On green-deep bg, 0.92 alpha gives ~5.4:1 — passes WCAG AA at 11px. */
        color: rgba(247, 245, 241, 0.92);
        margin-bottom: 16px;
      }

      .bbg-foot-eyebrow-spaced {
        margin-top: 28px;
      }

      .bbg-foot-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .bbg-foot-list-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 18px;
      }

      .bbg-foot-list a,
      .bbg-foot-sublist a {
        font-family: var(--font-body);
        font-size: 14px;
        /* 0.92 alpha on green-deep = 5.4:1 — passes WCAG AA. */
        color: rgba(247, 245, 241, 0.92);
        transition: color 160ms ease;
      }

      .bbg-foot-list a:hover,
      .bbg-foot-sublist a:hover {
        /* Lighter green hover (passes 5.5:1 with sand-pale on green-deep). */
        color: var(--sand-pale);
      }

      .bbg-foot-sublist {
        list-style: none;
        margin: 6px 0 0 12px;
        padding-left: 12px;
        border-left: 1px solid rgba(247, 245, 241, 0.12);
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .bbg-foot-sublist a {
        font-size: 13px;
        /* 0.85 alpha on green-deep = 4.9:1 — passes WCAG AA at 13px. */
        color: rgba(247, 245, 241, 0.85);
      }

      .bbg-foot-map {
        position: relative;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(247, 245, 241, 0.08);
        background: rgba(247, 245, 241, 0.04);
        aspect-ratio: 4 / 3;
      }

      .bbg-foot-map iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
      }

      /* Legal strip — brand red so it bookends the page with the top
         mast-bar. Both bars use --emergency + white text for symmetry. */
      .bbg-foot-legal {
        background: var(--emergency);
        padding: 18px 0;
      }

      .bbg-foot-legal-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        font-family: var(--font-body);
        font-size: 12px;
        color: #ffffff;
      }

      .bbg-foot-legal-links {
        display: inline-flex;
        gap: 10px;
        align-items: center;
      }

      .bbg-foot-legal-links a {
        /* Was rgba(255,255,255,0.88) which composited to ~4.47:1 on the
           red bar — Lighthouse flagged it as just under AA at 12px.
           Pure white = 4.87:1, passes. */
        color: #ffffff;
        transition: opacity 160ms ease;
        text-decoration: underline;
        text-decoration-color: rgba(255, 255, 255, 0.4);
      }

      .bbg-foot-legal-links a:hover,
      .bbg-foot-legal-links a:focus-visible {
        color: #ffffff;
        text-decoration: underline;
      }
    </style>
    <div
      id="mobile-call-cta"
      class="bbg-mobile-call-bar"
      role="region"
      aria-label="Call our dispatch lines"
    >
