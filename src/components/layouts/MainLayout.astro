---
// Import critical CSS inline and global CSS
import criticalCss from "../../styles/critical.css?inline";
import "../../styles/global.css";
import logoWordmark from "../../assets/logo-wordmark.svg";
import { buildCanonicalUrl, PREFERRED_SITE_ORIGIN } from "../../lib/canonical";
import { fetchMenuLinksByPageType } from "../../lib/queries/menuLinks";
import { fetchAllPageSlugs } from "../../lib/queries/allPages";
import { siteProfile } from "../../data/siteProfile";

interface Props {
  pageTitle?: string;
  description?: string;
  heroPreloadUrl?: string;
  heroPreloadSrcSet?: string;
  heroPreloadUrlMobile?: string;
  heroPreloadSrcSetMobile?: string;
  heroPreloadSizesMobile?: string;
  canonicalUrl?: string;
}

const {
  pageTitle = siteProfile.brandName,
  description = "Get Your Sleep Back!",
  heroPreloadUrl = "",
  heroPreloadSrcSet = "",
  heroPreloadUrlMobile = "",
  heroPreloadSrcSetMobile = "",
  heroPreloadSizesMobile = "",
  canonicalUrl,
} = Astro.props as Props;
const brandName = siteProfile.brandName;
const brandAbbrev = siteProfile.brandAbbrev;
const siteUrl = siteProfile.siteUrl;
const logoSrc = typeof logoWordmark === "string" ? logoWordmark : logoWordmark.src;
const absoluteLogoUrl = new URL(logoSrc, PREFERRED_SITE_ORIGIN).toString();
const primaryPhoneLabel = siteProfile.primaryPhoneFormatted;
const primaryPhoneHref = `tel:${siteProfile.primaryPhoneE164NoPlus}`;
const secondaryPhoneLabel = siteProfile.secondaryPhoneFormatted;
const secondaryPhoneHref = `tel:${siteProfile.secondaryPhoneE164NoPlus}`;
const gaMeasurementId = siteProfile.ga4MeasurementId;
const callRailCompanyId = siteProfile.callRailCompanyId;
const callRailSwapKey = siteProfile.callRailSwapKey;
const hasCallRail = Boolean(callRailCompanyId && callRailSwapKey);
const gaScript = gaMeasurementId
  ? `
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ${JSON.stringify(gaMeasurementId)});

      var __gaLoaded = false;
      function __loadGa() {
        if (__gaLoaded) return;
        __gaLoaded = true;
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ${JSON.stringify(gaMeasurementId)};
        document.head.appendChild(s);
        ['scroll','touchstart','mousemove','keydown'].forEach(function(ev){
          window.removeEventListener(ev, __loadGa, { passive: true });
        });
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(__loadGa, { timeout: 3000 });
      } else {
        setTimeout(__loadGa, 3000);
      }
      ['scroll','touchstart','mousemove','keydown'].forEach(function(ev){
        window.addEventListener(ev, __loadGa, { once: true, passive: true });
      });
    `
  : "";

const canonicalHref = buildCanonicalUrl({
  pathname: Astro.url.pathname,
  override: canonicalUrl,
  trailingSlash: "always",
  lowercase: true,
});

type MenuLinkLike = { label: string; href: string };
type PageTypeKey = "service-area" | "bed-bug-treatment";
type TopLevelMenuItem = { slug: string; label: string; href: string; children?: MenuLinkLike[] };
type FooterServiceLink = MenuLinkLike & { children?: MenuLinkLike[] };
const MENU_FETCH_TIMEOUT_MS = 1000;
const NAV_CACHE_TTL_MS = import.meta.env.DEV ? 15_000 : 60_000;
const EXCLUDED_HEADER_SLUGS = new Set([
  "privacy-policy",
  "terms-of-service",
  "terms-of-use",
  "terms-and-conditions"
]);

const FALLBACK_DESKTOP_NAV: TopLevelMenuItem[] = [
  { slug: "bed-bug-treatment", label: "Bed Bug Treatment", href: "/bed-bug-treatment/" },
  { slug: "service-area", label: "Service Area", href: "/service-area/" },
  { slug: "contact-us", label: "Contact Us", href: "/contact-us/" },
  { slug: "blog", label: "Blog", href: "/blog/" }
];
const FALLBACK_SERVICE_AREAS: MenuLinkLike[] = [];
const FALLBACK_TREATMENT_CHILDREN: MenuLinkLike[] = [];

const normalizeHref = (value: string) => {
  const trimmed = value.trim();
  if (!trimmed || trimmed === "/") return "/";
  return `/${trimmed.replace(/^\/+/, "").replace(/\/+$/, "")}/`;
};

const currentPath = normalizeHref(Astro.url.pathname);

const isActiveHref = (href: string) => {
  const normalizedHref = normalizeHref(href);
  if (normalizedHref === "/") return currentPath === "/";
  return currentPath === normalizedHref || currentPath.startsWith(normalizedHref);
};

const slugDepth = (slug: string) => slug.split("/").filter(Boolean).length;

const withTimedSanityFetch = async <T>(
  label: string,
  fallback: T,
  loader: (signal: AbortSignal) => Promise<T>
) => {
  const controller = new AbortController();
  const timeoutPromise = new Promise<T>((resolve) => {
    setTimeout(() => {
      controller.abort();
      console.warn(`MainLayout ${label} fetch timed out after ${MENU_FETCH_TIMEOUT_MS}ms; using fallback`);
      resolve(fallback);
    }, MENU_FETCH_TIMEOUT_MS);
  });
  try {
    const loaderPromise = loader(controller.signal).catch((error) => {
      console.warn(`MainLayout ${label} fetch failed; using fallback`, error);
      return fallback;
    });
    return await Promise.race([loaderPromise, timeoutPromise]);
  } catch (error) {
    console.warn(`MainLayout ${label} fetch failed; using fallback`, error);
    return fallback;
  }
};

type NavSnapshot = {
  allPageEntries: Awaited<ReturnType<typeof fetchAllPageSlugs>>;
  cmsServiceAreaPages: MenuLinkLike[];
  cmsTreatmentPages: MenuLinkLike[];
};

type GlobalNavCache = {
  __BBGN_MENU_CACHE__?: {
    expiresAt: number;
    snapshot: NavSnapshot;
  };
};

const globalNavCache = globalThis as typeof globalThis & GlobalNavCache;

const loadNavSnapshot = async (): Promise<NavSnapshot> => {
  const cached = globalNavCache.__BBGN_MENU_CACHE__;
  if (cached && cached.expiresAt > Date.now()) {
    return cached.snapshot;
  }

  const [allPageEntries, cmsServiceAreaPages, cmsTreatmentPages] = await Promise.all([
    withTimedSanityFetch("all-page-slugs", [], (signal) => fetchAllPageSlugs({ signal })),
    withTimedSanityFetch("service-area-menu", [], (signal) =>
      fetchMenuLinksByPageType("service-area", { signal })
    ),
    withTimedSanityFetch("bed-bug-treatment-menu", [], (signal) =>
      fetchMenuLinksByPageType("bed-bug-treatment", { signal })
    )
  ]);

  const snapshot: NavSnapshot = {
    allPageEntries,
    cmsServiceAreaPages,
    cmsTreatmentPages
  };

  globalNavCache.__BBGN_MENU_CACHE__ = {
    expiresAt: Date.now() + NAV_CACHE_TTL_MS,
    snapshot
  };

  return snapshot;
};

const { allPageEntries, cmsServiceAreaPages, cmsTreatmentPages } = await loadNavSnapshot();

const existingRouteHrefs = new Set(
  allPageEntries.map((entry) => {
    const normalizedSlug = (entry.slug ?? "").trim();
    return normalizedSlug ? normalizeHref(normalizedSlug) : "/";
  })
);
existingRouteHrefs.add("/");

const resolveMenuHref = (href: string, pageType: PageTypeKey) => {
  const normalized = normalizeHref(href);
  const normalizedSlug = normalized === "/" ? "" : normalized.slice(1, -1);
  const segments = normalizedSlug.split("/").filter(Boolean);

  const candidates = [normalized];

  if (segments.length === 1) {
    candidates.push(normalizeHref(`/${pageType}/${segments[0]}/`));
  } else if (segments[0] === pageType) {
    const leaf = segments[segments.length - 1];
    candidates.push(normalizeHref(`/${leaf}/`));
  }

  for (const candidate of candidates) {
    if (existingRouteHrefs.has(candidate)) {
      return candidate;
    }
  }

  return null;
};

const dedupeLinksByHref = (items: MenuLinkLike[]) => {
  const seen = new Set<string>();
  return items.filter((item) => {
    if (seen.has(item.href)) return false;
    seen.add(item.href);
    return true;
  });
};

const toValidDropdownLinks = (items: MenuLinkLike[], pageType: PageTypeKey) =>
  dedupeLinksByHref(
    items
      .map((item) => {
        const resolvedHref = resolveMenuHref(item.href, pageType);
        if (!resolvedHref) return null;
        return { ...item, href: resolvedHref };
      })
      .filter((item): item is MenuLinkLike => Boolean(item?.label) && Boolean(item?.href))
  );

for (const item of FALLBACK_DESKTOP_NAV) {
  existingRouteHrefs.add(item.href);
}

const cmsServiceAreaChildren = cmsServiceAreaPages.filter((item) => item.href !== "/service-area/");
const validServiceAreas = toValidDropdownLinks(cmsServiceAreaChildren, "service-area");
const serviceAreas = validServiceAreas.length > 0 ? validServiceAreas : FALLBACK_SERVICE_AREAS;

// Featured cities for the header dropdown. The full list still lives at
// /service-area/ and is reachable via the "View all locations" entry appended below.
const FEATURED_NAV_SERVICE_AREA_SLUGS = new Set([
  "arlington-heights-il",
  "chicago-il",
  "evanston-il",
  "kenosha-wi",
  "milwaukee-wi",
  "naperville-il",
  "racine-wi",
  "schaumburg-il",
  "waukegan-il",
  "zion-il"
]);
const featuredOrder = Array.from(FEATURED_NAV_SERVICE_AREA_SLUGS);
const navServiceAreasFiltered = serviceAreas
  .filter((area) => {
    const slug = area.href.replace(/^\/service-area\//, "").replace(/\/$/, "");
    return FEATURED_NAV_SERVICE_AREA_SLUGS.has(slug);
  })
  .sort((a, b) => {
    const slugA = a.href.replace(/^\/service-area\//, "").replace(/\/$/, "");
    const slugB = b.href.replace(/^\/service-area\//, "").replace(/\/$/, "");
    return featuredOrder.indexOf(slugA) - featuredOrder.indexOf(slugB);
  });
// Fall back to the full unfiltered list if Sanity is missing every featured
// city — better an oversized dropdown than an empty one.
const navServiceAreas: MenuLinkLike[] =
  navServiceAreasFiltered.length > 0 ? navServiceAreasFiltered : serviceAreas;

const cmsTreatmentChildren = cmsTreatmentPages.filter((item) => item.href !== "/bed-bug-treatment/");
const validTreatmentChildren = toValidDropdownLinks(cmsTreatmentChildren, "bed-bug-treatment");
const treatmentChildren =
  validTreatmentChildren.length > 0 ? validTreatmentChildren : FALLBACK_TREATMENT_CHILDREN;

const bedBugTreatmentOverviewHref =
  resolveMenuHref("/bed-bug-treatment/", "bed-bug-treatment") ?? "/bed-bug-treatment/";
const filteredTreatmentChildren = treatmentChildren.filter(
  (item) => normalizeHref(item.href) !== bedBugTreatmentOverviewHref
);

const preferredTopLevelOrder = ["bed-bug-treatment", "service-area", "blog", "contact-us"];
const priorityBySlug = new Map(preferredTopLevelOrder.map((slug, index) => [slug, index]));
const CANONICAL_NAV_LABELS: Record<string, string> = {
  "bed-bug-treatment": "Bed Bug Treatment",
  "service-area": "Service Area",
  blog: "Blog",
  "contact-us": "Contact Us",
};

const topLevelCmsPages = allPageEntries
  .filter((entry) => Boolean(entry.slug) && Boolean(entry.title))
  .filter((entry) => (entry.slug ?? "") !== "home")
  .filter((entry) => slugDepth(entry.slug ?? "") === 1)
  .map((entry) => {
    const slug = (entry.slug ?? "").trim().toLowerCase();
    return {
      slug,
      label: CANONICAL_NAV_LABELS[slug] ?? (entry.title ?? "").trim(),
      href: normalizeHref(slug)
    };
  })
  .filter((entry) => !EXCLUDED_HEADER_SLUGS.has(entry.slug))
  .filter((entry) => preferredTopLevelOrder.includes(entry.slug))
  .filter((entry) => Boolean(entry.label) && existingRouteHrefs.has(entry.href))
  .filter((entry, index, array) => array.findIndex((candidate) => candidate.href === entry.href) === index)
  .sort((a, b) => {
    const aPriority = priorityBySlug.get(a.slug) ?? Number.MAX_SAFE_INTEGER;
    const bPriority = priorityBySlug.get(b.slug) ?? Number.MAX_SAFE_INTEGER;
    if (aPriority !== bPriority) return aPriority - bPriority;
    return a.label.localeCompare(b.label);
  });

const decorateTopLevelNav = (item: TopLevelMenuItem): TopLevelMenuItem => {
  if (item.slug === "bed-bug-treatment") {
    return { ...item, href: bedBugTreatmentOverviewHref, children: filteredTreatmentChildren };
  }

  if (item.slug === "service-area") {
    return { ...item, children: navServiceAreas };
  }

  return item;
};

const desktopNavItems: TopLevelMenuItem[] =
  topLevelCmsPages.length > 0
    ? topLevelCmsPages.map(decorateTopLevelNav)
    : FALLBACK_DESKTOP_NAV.map(decorateTopLevelNav);

// Keep mobile menu behavior, but drive it from validated CMS nav data.
const MOBILE_NAV: TopLevelMenuItem[] = [{ slug: "home", label: "Home", href: "/" }, ...desktopNavItems];
const quickLinks = [
  { label: "Home", href: "/" },
  { label: "Service Area", href: "/service-area/" },
  { label: "Contact Us", href: "/contact-us/" },
  { label: "Blog", href: "/blog/" },
  { label: "Content & Section Guide", href: "/template-guide/" },
];
const footerServiceLinks: FooterServiceLink[] = [
  {
    label: "Bed Bug Treatment",
    href: "/bed-bug-treatment/",
    children: [
      { label: "Heat Treatment", href: "/bed-bug-treatment/heat-extermination/" },
      { label: "Conventional Treatment", href: "/bed-bug-treatment/conventional-extermination/" },
      { label: "Aprehend", href: "/bed-bug-treatment/aprehend-extermination/" }
    ]
  }
];
// Resolve the canonical terms link. Live URL is /terms-of-service/, which
// is what we prefer. Older `terms-of-use` / `terms-and-conditions` slugs
// are kept as fallbacks until the Sanity doc rename ships, and then a
// 301 in vercel.json catches anyone hitting the old URL anyway.
const termsHref = existingRouteHrefs.has("/terms-of-service/")
  ? "/terms-of-service/"
  : existingRouteHrefs.has("/terms-of-use/")
    ? "/terms-of-use/"
    : existingRouteHrefs.has("/terms-and-conditions/")
      ? "/terms-and-conditions/"
      : "/terms-of-service/";

