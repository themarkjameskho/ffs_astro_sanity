# =====================================================================
# FFS Astro+Sanity Template — Environment Variables
#
# Copy this file to `.env` (which is gitignored) and replace every
# placeholder. Also configure these in Vercel → Project → Settings →
# Environment Variables for production, preview, AND development.
# Env vars are baked at Vercel build time — adding a var after a build
# requires a manual redeploy to take effect.
# =====================================================================

# --- Sanity CMS (server-side, never exposed to browser) ---
SANITY_PROJECT_ID={{SANITY_PROJECT_ID}}
SANITY_DATASET=production
# Read+write token from Sanity Manage → API → Tokens.
# Rotate periodically. Never commit, never paste in chat.
SANITY_API_TOKEN={{SANITY_API_TOKEN_REPLACE_ME}}
# Optional — for some studio admin flows.
# SANITY_ORGANIZATION_ID={{SANITY_ORGANIZATION_ID}}

# --- Sanity Studio (same project/dataset) ---
SANITY_STUDIO_PROJECT_ID={{SANITY_PROJECT_ID}}
SANITY_STUDIO_DATASET=production

# --- Public Sanity config (client-side safe to expose) ---
PUBLIC_SANITY_PROJECT_ID={{SANITY_PROJECT_ID}}
PUBLIC_SANITY_DATASET=production

# --- ISR revalidate webhook secret ---
# Vercel ISR bypass token. Configure the matching secret in Sanity
# Manage → API → Webhooks pointing at:
#   https://{{SITE_DOMAIN}}/api/revalidate?secret=<token>
SANITY_WEBHOOK_SECRET={{SANITY_WEBHOOK_SECRET_REPLACE_ME}}

# --- Form-submission webhook (n8n / Zapier / HubSpot / etc.) ---
# Where lead-form submissions get forwarded. Set in Vercel too.
AUTOMATION_WEBHOOK_URL={{AUTOMATION_WEBHOOK_URL}}

# =====================================================================
# Cloudflare Turnstile (form anti-spam) — REQUIRED for production
# =====================================================================
# Get the keys from https://dash.cloudflare.com → Turnstile → Add Site.
# Pick "Managed" widget mode; add this project's production AND preview
# domains. Cloudflare gives you a public Site Key and a private Secret
# Key — paste both placeholders below, and also into Vercel env vars.
PUBLIC_TURNSTILE_SITE_KEY={{PUBLIC_TURNSTILE_SITE_KEY}}
TURNSTILE_SECRET_KEY={{TURNSTILE_SECRET_KEY}}
